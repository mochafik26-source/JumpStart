{
    "id": "cypress",
    "name": "Cypress",
    "install": {
        "arch": [
            "sudo pacman -Syu --noconfirm",
            "sudo pacman -S --noconfirm nodejs npm",
            "npm install -g cypress"
        ],
        "all": [
            "npm install -D cypress"
        ]
    },
    "verify": [
        "npx cypress --version"
    ]
}