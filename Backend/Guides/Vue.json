"{\n    \"id\": \"vue-cli\",\n    \"name\": \"Vue CLI installation guide\",\n    \"install\": {\n        \"arch\": [\n            \"sudo pacman -Syu nodejs npm\",\n            \"sudo npm install -g @vue/cli\"\n        ],\n        \"ubuntu\": [\n            \"sudo apt-get update\",\n            \"sudo apt-get install -y nodejs npm\",\n            \"sudo npm install -g @vue/cli\"\n        ],\n        \"all\": [\n            \"npm install -g @vue/cli\"\n        ]\n    },\n    \"verify\": [\n        \"node --version\",\n        \"npm --version\",\n        \"vue --version\"\n    ]\n}"