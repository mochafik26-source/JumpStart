{
    "id": "pandas",
    "name": "Pandas",
    "install": {
        "arch": [
            "pacman -S python-pandas"
        ],
        "ubuntu": [
            "apt-get update",
            "apt-get install -y python3-pandas"
        ],
        "all": [
            "python3 -m pip install pandas"
        ]
    },
    "verify": [
        "python -c \"import pandas as pd; print(pd.__version__)\""
    ]
}