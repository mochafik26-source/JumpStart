{
    "id": "tailwind",
    "name": "Tailwind CSS",
    "install": {
        "arch": [
            "sudo pacman -Syu nodejs npm",
            "npm install -g tailwindcss"
        ],
        "ubuntu": [
            "sudo apt-get update",
            "sudo apt-get install -y nodejs npm",
            "npm install -g tailwindcss"
        ],
        "all": [
            "npm install -D tailwindcss"
        ]
    },
    "verify": [
        "tailwindcss -v"
    ]
}