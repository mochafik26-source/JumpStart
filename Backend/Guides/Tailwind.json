"{\n    \"id\": \"tailwind\",\n    \"name\": \"Tailwind CSS\",\n    \"install\": {\n        \"arch\": [\n            \"sudo pacman -Syu nodejs npm\",\n            \"npm install -D tailwindcss\"\n        ],\n        \"ubuntu\": [\n            \"sudo apt update\",\n            \"sudo apt install -y nodejs npm\",\n            \"npm install -D tailwindcss\"\n        ],\n        \"all\": [\n            \"npm install -D tailwindcss\"\n        ]\n    },\n    \"verify\": [\n        \"npx tailwindcss -v\",\n        \"tailwindcss -v\"\n    ]\n}"